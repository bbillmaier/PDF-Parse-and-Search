    },
    {
      "blocks": [
        {
          "id": "table-12",
          "pageNumber": 38,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-812",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-731",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Instruments. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-732",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Temperature gauges. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-733",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Pressure gauges.  Ammeter/voltmeter. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-734",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Mirrors. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-735",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Tires. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-736",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o Cargo, cargo covers. Lights, etc. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-737",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "o If the trainee sees, hears, smells, or  feels anything that might mean  trouble, he/she should check it out. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-902",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-738",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "• Safety inspection. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-903",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-739",
                              "pageNumber": 38,
                              "text": [
                                {
                                  "text": "• Document any discrepancy on AF  Form 1800.  Sign-off AF Form 1800  to signify accomplishment of  inspection. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-904",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 38,
                      "type": "list",
                    },
