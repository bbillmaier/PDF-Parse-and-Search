                  "blocks": [
                    {
                      "id": "p-342",
                      "pageNumber": 17,
                      "text": [
                        {
                          "text": "Initial fall hazard survey date? ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-22",
                  "isHeader": true,
                  "pageNumber": 17,
                  "rowSpan": 1,
                },
                {
                  "blocks": [],
                  "colSpan": 1,
