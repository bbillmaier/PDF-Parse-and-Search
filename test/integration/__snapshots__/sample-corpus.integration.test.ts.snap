                },
                {
                  "blocks": [
                    {
                      "id": "p-820",
                      "pageNumber": 58,
                      "text": [
                        {
                          "text": "Ladder Safety Systems ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-91",
                  "isHeader": true,
                  "pageNumber": 58,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [],
                  "colSpan": 1,
                  "id": "th-92",
                  "isHeader": true,
                  "pageNumber": 58,
                  "rowSpan": 1,
                },
                {
                  "blocks": [],
                  "colSpan": 1,
                  "id": "td-71",
                  "isHeader": false,
                  "pageNumber": 58,
                  "rowSpan": 1,
                },
                {
                  "blocks": [],
                  "colSpan": 1,
                  "id": "td-72",
                  "isHeader": false,
                  "pageNumber": 58,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
        {
          "altText": undefined,
          "caption": undefined,
          "id": "fig-45",
          "imageId": "img-189-0",
          "pageNumber": 58,
          "type": "figure",
          "unsupported": false,
        },
        {
          "altText": undefined,
