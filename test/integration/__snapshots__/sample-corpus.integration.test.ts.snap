      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-10",
          "pageNumber": 36,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-807",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-678",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Get in and turn-off all lights.  ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-875",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-679",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Turn-on stop lights (apply trailer  hand brake or have a helper put on  the brake pedal). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-876",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-680",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Turn-on left turn signal lights. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-877",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-681",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Get out and check lights. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-878",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-682",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Left front turn signal light clean,  operating and proper color (amber or  white on signals facing the front). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-879",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-683",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Left rear turn signal light and both  stop lights clean operating, and  proper color (red, yellow, or amber). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-880",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-684",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Get in vehicle. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-881",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 36,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-75",
                  "isHeader": false,
                  "pageNumber": 36,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-809",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-685",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Rear clearance and identification  lights clean, operating, and proper  color (red at rear). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-686",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Reflectors clean and proper color  (red at rear). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-687",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Taillights clean, operating, and  proper color (red at rear). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-688",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Right rear turn signal operating, and  proper color (red, yellow, or amber  at rear). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-689",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o License plate(s) present, clean, and  secured. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-690",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Splash guards present, not damaged,  properly fastened, not dragging on  ground, or rubbing tires. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-691",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "o Rear doors securely closed,  latched/locked. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-882",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-692",
                              "pageNumber": 36,
                              "text": [
                                {
                                  "text": "• Left side. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "list-808",
                              "items": [
                                {
                                  "blocks": [
                                    {
                                      "id": "p-694",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Check all items as done on right side,  plus: ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-883",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-696",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Battery (batteries) (if not mounted in  engine compartment). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-884",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-698",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Battery (batteries) secured against  movement. Battery (batteries) not  broken or leaking. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-885",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-700",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Fluid in battery (batteries) at proper  level (except maintenance-free type). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-886",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-702",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Cell caps present and securely  tightened (except maintenance-free  type). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-887",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-704",
                                      "pageNumber": 36,
                                      "text": [
                                        {
                                          "text": "Vents in cell caps free of foreign  material (except maintenance-free  type). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-888",
                                },
                              ],
                              "ordered": false,
                              "pageNumber": 36,
                              "type": "list",
                            },
                          ],
                          "id": "li-889",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 36,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-58",
                  "isHeader": true,
                  "pageNumber": 36,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 36,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "List on page 36 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 36,
        },
      ],
      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-11",
          "pageNumber": 37,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-810",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-706",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "Turn-off lights not needed for  driving. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-890",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-708",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "Check for all required papers, trip  manifests, permits, etc. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-891",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-710",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "Secure all loose articles (they might  interfere with operation of the  controls or hit the operator in a  crash). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-892",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-712",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "Start the engine. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-893",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 37,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-59",
                  "isHeader": true,
                  "pageNumber": 37,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "list-811",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-713",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "• Test for hydraulic leaks. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-894",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-714",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o If the vehicle has hydraulic brakes,  pump the brake pedal three times. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-715",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Then apply firm pressure to the pedal  and hold for five seconds. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-716",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o The pedal should not move.  If it  does, there may be a leak or other  problem. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-895",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-717",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "• Brake system. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-896",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-718",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "• Test parking brake. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-897",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-719",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Fasten safety belt. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-720",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Set parking brake (power unit only).  Release trailer parking brake (if  applicable). Place vehicle into a low  gear. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-721",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Gently pull forward against parking  brake to make sure the parking brake  holds. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-722",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Repeat the same steps for the trailer  with trailer parking brake set and  power unit parking brakes released  (if applicable). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-723",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o If it doesn't hold vehicle, it is faulty;  get it fixed. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-898",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-724",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "• Test service brake stopping action. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-899",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-725",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Go about 5 miles per hour. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-726",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Push brake pedal firmly. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-727",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o "Pulling" to one side or the other can  mean brake trouble. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-728",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o Any unusual brake pedal "feel" or  delayed stopping action can mean  trouble. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-729",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "o If the trainee finds anything unsafe  during the Vehicle inspection, get it  fixed. Federal and state laws forbid  operating an unsafe vehicle. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-900",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-730",
                              "pageNumber": 37,
                              "text": [
                                {
                                  "text": "• Check vehicle operation regularly: ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-901",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 37,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-76",
                  "isHeader": false,
                  "pageNumber": 37,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 37,
