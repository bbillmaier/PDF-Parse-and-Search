                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-49",
                  "isHeader": true,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "p-574",
                      "pageNumber": 31,
                      "text": [
                        {
                          "text": "Procedure ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-69",
                  "isHeader": false,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "p-575",
                      "pageNumber": 31,
                      "text": [
                        {
                          "text": "1.  Vehicle Overview ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-50",
                  "isHeader": true,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "list-794",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-576",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "• Review the AF Form 1800. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-832",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-577",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Ensure any discrepancy has been  corrected. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-578",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Vehicle Management annotated the  discrepancy was completed. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-579",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Approaching the vehicle. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "list-793",
                              "items": [
                                {
                                  "blocks": [
                                    {
                                      "id": "p-580",
                                      "pageNumber": 31,
                                      "text": [
                                        {
                                          "text": "▪ Damage or vehicle leaning to one  side. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-833",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-581",
                                      "pageNumber": 31,
                                      "text": [
                                        {
                                          "text": "▪ Fresh leakage of fluids. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-834",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-582",
                                      "pageNumber": 31,
                                      "text": [
                                        {
                                          "text": "▪ Hazards around vehicle. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-835",
                                },
                              ],
                              "ordered": false,
                              "pageNumber": 31,
                              "type": "list",
                            },
                          ],
                          "id": "li-836",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 31,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-70",
                  "isHeader": false,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "p-583",
                      "pageNumber": 31,
                      "text": [
                        {
                          "text": "2.  Check Engine Compartment ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-51",
                  "isHeader": true,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "list-795",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-584",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "• Note:  Check that the parking brakes  are on and/or wheels chocked.  The  operator may have to raise the hood,  tilt the cab (secure loose things so  they don't fall and break something),  or open the engine compartment  door. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-837",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-585",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "• Check the following: ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-838",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-586",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Engine oil level. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-587",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Coolant level in radiator; condition of  hoses. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-588",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Power steering fluid level; hose  condition (if so equipped). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-589",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Windshield washer fluid level. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-590",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Battery fluid level, connections and  tie-downs (battery may be located  elsewhere). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-591",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Automatic transmission fluid level  (may require engine to be running). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-592",
                              "pageNumber": 31,
                              "text": [
                                {
                                  "text": "o Check belts for tightness and  excessive wear (alternator, water  pump, air compressor)--learn how  much "give" the belts should have  when adjusted right. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-839",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 31,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-71",
                  "isHeader": false,
                  "pageNumber": 31,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 31,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "List on page 31 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 31,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 31 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 31,
        },
      ],
      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-6",
          "pageNumber": 32,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "p-593",
                      "pageNumber": 32,
                      "text": [
                        {
                          "text": "• Make sure parking brake is on. ",
                        },
                        {
                          "text": "• Put gearshift in neutral (or park if  automatic).  Start engine; listen for  unusual noises. ",
                        },
                        {
                          "text": "• If equipped, check the Anti-lock  Braking System (ABS) indicator  lights.  Light on dash should come on  and then turn-off.  If it stays on the  ABS is not working properly. ",
                        },
                        {
                          "text": "• Look at the gauges. ",
                        },
                        {
                          "text": "o Oil pressure. Should come up to ",
                        },
                        {
                          "text": "normal within seconds after engine is  started. ",
                        },
                        {
                          "text": "o Ammeter and/or voltmeter. Should be ",
                        },
                        {
                          "text": "in normal range(s). ",
                        },
                        {
                          "text": "o Coolant temperature. Should begin ",
                        },
                        {
                          "text": "gradual rise to normal operating  range. ",
                        },
                        {
                          "text": "o Engine oil temperature. Should begin ",
                        },
                        {
                          "text": "gradual rise to normal operating  range. ",
                        },
                        {
                          "text": "o Check Condition of Controls. Check  all of the following for looseness,  sticking, damage, or improper  setting: ",
                        },
                        {
                          "text": "▪ Steering wheel. ",
                        },
                        {
                          "text": "▪ Accelerator (gas pedal). ",
                        },
                        {
                          "text": "▪ Brake controls. ",
                        },
                        {
                          "text": "▪ Foot brake. ",
                        },
                        {
                          "text": "▪ Parking brake. ",
                        },
                        {
                          "text": "▪ Transmission controls. ",
                        },
                        {
                          "text": "▪ Horn(s). ",
                        },
                        {
                          "text": "▪ Windshield wiper/washer. ",
                        },
                        {
                          "text": "▪ Lights. ",
                        },
                        {
                          "text": "▪ Headlights. ",
                        },
                        {
                          "text": "▪ Dimmer switch. ",
                        },
                        {
                          "text": "▪ Turn signal. ",
                        },
                        {
                          "text": "▪ Four-way flashers. ",
                        },
                        {
                          "text": "▪ Parking – clearance – identification –  marker switch (switches). ",
                        },
                        {
                          "text": "• Check mirrors and windshield. ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-72",
                  "isHeader": false,
                  "pageNumber": 32,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "list-796",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-594",
                              "pageNumber": 32,
                              "text": [
                                {
                                  "text": "o Leaks in the engine compartment  (fuel, coolant, oil, power steering  fluid, hydraulic fluid, battery fluid). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-840",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 32,
                      "type": "list",
                    },
                    {
                      "id": "p-595",
                      "pageNumber": 32,
                      "text": [
                        {
                          "text": "Cracked, worn electrical wiring  insulation. ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-52",
                  "isHeader": true,
                  "pageNumber": 32,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "p-596",
                      "pageNumber": 32,
                      "text": [
                        {
                          "text": "3.  Start Engine and Inspect Inside the Cab  (Get in and Start Engine) ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-53",
                  "isHeader": true,
                  "pageNumber": 32,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 32,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "A L element was nested inside inline text on page 32; its structure was flattened to plain text.",
          "pageNumber": 32,
        },
        {
          "code": "structure-inconsistency",
          "message": "A L element was nested inside inline text on page 32; its structure was flattened to plain text.",
          "pageNumber": 32,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 32 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 32,
        },
      ],
      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-7",
          "pageNumber": 33,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-798",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-597",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "• General. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "list-797",
                              "items": [
                                {
                                  "blocks": [
                                    {
                                      "id": "p-599",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Go to front of vehicle and check that  low beams are on and both of the  four-way flashers are working. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-841",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-601",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Push dimmer switch and check that  high beams work. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-842",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-603",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Turn-off headlights and four-way  emergency flashers. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-843",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-605",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Turn-on parking, clearance, side- marker, and identification lights. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-844",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-607",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Turn-on right turn signal, and start  walk-around inspection. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-845",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-609",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "Walk around and inspect. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-846",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-610",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Clean all lights, reflectors, and glass  as while doing the walk-around  inspection. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-847",
                                },
                              ],
                              "ordered": false,
                              "pageNumber": 33,
                              "type": "list",
                            },
                          ],
                          "id": "li-848",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-611",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "• Left front side. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-849",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-612",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "o Driver's door glass should be clean. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-613",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "o Door latches or locks should work  properly. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-850",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-614",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "• Left front wheel. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-851",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 33,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-73",
                  "isHeader": false,
                  "pageNumber": 33,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-800",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-615",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "o Inspect mirrors and windshield for  cracks, dirt, illegal stickers, or other  obstructions to seeing clearly.  Clean  and adjust as necessary. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-852",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-616",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "• Check emergency equipment. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-853",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-617",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "o Check for safety equipment: ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "list-799",
                              "items": [
                                {
                                  "blocks": [
                                    {
                                      "id": "p-618",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Spare electrical fuses (unless vehicle  has circuit breakers). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-854",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-619",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Three red reflective triangles, 6 fuses  or 3 liquid burning flares. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-855",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-620",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Properly charged and rated fire  extinguisher.  Check for optional  items such as: ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-856",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-621",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Chains (where winter conditions  require). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-857",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-622",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ Tire changing equipment. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-858",
                                },
                                {
                                  "blocks": [
                                    {
                                      "id": "p-623",
                                      "pageNumber": 33,
                                      "text": [
                                        {
                                          "text": "▪ List of emergency phone numbers  Accident reporting kit (packet). ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-859",
                                },
                              ],
                              "ordered": false,
                              "pageNumber": 33,
                              "type": "list",
                            },
                            {
                              "id": "p-624",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "o Check safety belt. Check that the  safety belt is securely mounted,  adjusts; latches properly and is not  ripped or frayed. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-860",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 33,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-54",
                  "isHeader": true,
                  "pageNumber": 33,
                  "rowSpan": 1,
                },
              ],
            },
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "p-625",
                      "pageNumber": 33,
                      "text": [
                        {
                          "text": "4.  Turn-off Engine ",
                        },
                      ],
                      "type": "paragraph",
                    },
                    {
                      "id": "p-626",
                      "pageNumber": 33,
                      "text": [
                        {
                          "text": "5.  Do Walk-Around Inspection ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-55",
                  "isHeader": true,
                  "pageNumber": 33,
                  "rowSpan": 1,
                },
                {
                  "blocks": [
                    {
                      "id": "list-801",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-627",
                              "pageNumber": 33,
                              "text": [
                                {
                                  "text": "• Turn-on headlights (low beams) and  four-way emergency flashers, and get  out of the vehicle. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-861",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 33,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "td-74",
                  "isHeader": false,
                  "pageNumber": 33,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 33,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "List on page 33 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 33,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 33 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 33,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 33 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 33,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 33 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 33,
        },
      ],
      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-8",
          "pageNumber": 34,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-802",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-628",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of wheel and rim-- missing, bent, broken studs, clamps,  lugs, or any signs of misalignment. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-629",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of tires--properly inflated,  valve stem and cap OK, no serious  cuts, bulges, or tread wear. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-630",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Hub oil level OK, no leaks. Left  front suspension. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-631",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of spring, spring hangers,  shackles, ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-632",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o U-bolts. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-633",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Shock absorber condition. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-862",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-634",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "• Left front brake. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-863",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-635",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of brake drum or disc. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-636",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of hoses. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-864",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-637",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "• Front. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-865",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-638",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of front axle. Condition of  steering system. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-866",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 34,
                      "type": "list",
                    },
                    {
                      "id": "list-803",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-639",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o No loose, worn, bent, damaged or  missing parts. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-640",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Must grab steering mechanism to test  for looseness. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-641",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of windshield. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-642",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Check for damage and clean if dirty. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-643",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Check windshield wiper arms for  proper spring tension. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-644",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Check wiper blades for damage,  "stiff" rubber, and securement. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-645",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Lights and reflectors. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-646",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Parking, clearance, and identification  lights clean, operating, and proper  color (amber at front). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-647",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Reflectors clean and proper color  (amber at front). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-648",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Right front turn signal light clean,  operating, and proper color (amber  or white on signals facing forward). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-867",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-649",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "• Right side ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-868",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-650",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Right front: check all items as done  on left front. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-651",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Right fuel tank(s). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-652",
                              "pageNumber": 34,
                              "text": [
                                {
                                  "text": "o Condition of visible parts. Rear of  engine--not leaking. Transmission-- not leaking. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-869",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 34,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-56",
                  "isHeader": true,
                  "pageNumber": 34,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 34,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "List on page 34 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 34,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 34 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 34,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 34 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 34,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 34 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 34,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 34 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 34,
