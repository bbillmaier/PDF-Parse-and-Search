    {
      "blocks": [
        {
          "id": "p-387",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.3. Explain driving techniques. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-388",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.4. Ensure the driver is aware of driving situations. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-389",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.5. Conduct after-action reviews with the trainee. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-390",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.6. Trainee is not allowed any instructor assists to pass performance evaluation. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-391",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.7. Evaluation checklist provided in Attachment 3. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-392",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.8. Retraining; retrain No-Go’s. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-393",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.8.1. Re-demonstrate “No-Go” items. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-394",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.8.2. Have trainee re-perform until they show proficiency in operating, critique  weaknesses as observed. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-395",
          "pageNumber": 21,
          "text": [
            {
              "text": "7.2.8.3. Re-evaluate. ",
            },
          ],
          "type": "paragraph",
        },
      ],
