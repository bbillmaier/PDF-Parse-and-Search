      "width": 612,
    },
    {
      "blocks": [
        {
          "id": "table-9",
          "pageNumber": 35,
          "rows": [
            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "list-804",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-653",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Exhaust system--secure, not leaking,  not touching wires, fuel. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-654",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Frame and cross members--no bends  or cracks. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-655",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Spare tire and/or wheel securely  mounted. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-656",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Cargo/passengers properly secured. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-657",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Spare tire and wheel adequate  (proper size, properly inflated). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-658",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o If oversize, all required signs (flags,  lamps, and reflectors) safely and  properly mounted and all required  permits in driver's possession. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-870",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 35,
                      "type": "list",
                    },
                    {
                      "id": "list-806",
                      "items": [
                        {
                          "blocks": [
                            {
                              "id": "p-659",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "• Right rear. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-871",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-660",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Condition of wheels and rims--no  missing, bent, or lugs. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-661",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Condition of tires--properly inflated,  valve stems and caps OK, no serious  cuts, bulges, tread wear, tires not  rubbing each other, and nothing  stuck between them. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-662",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Tires same type, e.g. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-663",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Tires evenly matched (same sizes).  Wheel bearing/seals not leaking. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-664",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Suspension. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-665",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Condition of spring(s), spring  hangers, shackles, and U-bolts. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-666",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Axle secure. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-667",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Powered axle(s) not leaking lube  (gear oil). Condition of torque rod  arms, bushings. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-668",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Condition of shock absorber(s). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-669",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Brakes. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-670",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Brake adjustment. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-671",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Condition of brake drum(s) or discs. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-672",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Lights and reflectors. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-673",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Side-marker lights clean, operating,  and proper color (red at rear, others  amber). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "p-674",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "o Side-marker reflectors clean and  proper color (red at rear, others  amber). ",
                                },
                              ],
                              "type": "paragraph",
                            },
                          ],
                          "id": "li-872",
                        },
                        {
                          "blocks": [
                            {
                              "id": "p-675",
                              "pageNumber": 35,
                              "text": [
                                {
                                  "text": "• Rear. ",
                                },
                              ],
                              "type": "paragraph",
                            },
                            {
                              "id": "list-805",
                              "items": [
                                {
                                  "blocks": [
                                    {
                                      "id": "p-677",
                                      "pageNumber": 35,
                                      "text": [
                                        {
                                          "text": "Lights and reflectors. ",
                                        },
                                      ],
                                      "type": "paragraph",
                                    },
                                  ],
                                  "id": "li-873",
                                },
                              ],
                              "ordered": false,
                              "pageNumber": 35,
                              "type": "list",
                            },
                          ],
                          "id": "li-874",
                        },
                      ],
                      "ordered": false,
                      "pageNumber": 35,
                      "type": "list",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-57",
                  "isHeader": true,
                  "pageNumber": 35,
                  "rowSpan": 1,
                },
              ],
            },
          ],
          "type": "table",
        },
      ],
      "height": 792,
      "pageNumber": 35,
      "warnings": [
        {
          "code": "structure-inconsistency",
          "message": "List on page 35 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 35,
        },
        {
          "code": "structure-inconsistency",
          "message": "List on page 35 contains a non-LI child (role L); treated as one list item.",
          "pageNumber": 35,
