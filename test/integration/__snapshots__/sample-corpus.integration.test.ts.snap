            },
            {
              "text": " ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-298",
          "pageNumber": 14,
          "text": [
            {
              "text": "(https://www.osha.gov/laws-regs/regulations/standardnumber/1926/1926.503) ",
            },
          ],
          "type": "paragraph",
        },
        {
