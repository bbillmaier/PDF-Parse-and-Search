    {
      "blocks": [
        {
          "id": "p-153",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.4.1.  Engine oil. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-154",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.4.2.  Coolant. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-155",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.4.3.  Power steering fluid. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-156",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.4.4.  Transmission fluid. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-157",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.4.5.  Antifreeze. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-158",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.5.   Battery; security, fluid, damage and corrosion. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-159",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.6.   All wheel rims (cracks, splits, etc.); check for loose or missing lug nuts. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-160",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.7.   All tires.  ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-161",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.7.1.  Proper inflation. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-162",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.7.2.  Sidewalls, tread to include depth, bulges. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-163",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.7.3.  Cuts and abrasions. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-164",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.7.4.  Lug nuts. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-165",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.8.   Transmission. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-166",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.9.   Drive belts; tension and fraying. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-167",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.10.  All hoses and wiring. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-168",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.11.  Differential, shocks and brakes for leaks. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-169",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.12.  Suspension, springs and shocks. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-170",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.13.  Fuel door and fuel cap; intact, not broken or damaged. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-171",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.14.  Horn operation. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-172",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.15.  Control panel. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-173",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.16.  Heater/defroster. ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-174",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.17.  Wiring/lights/reflectors (interior and exterior). ",
            },
          ],
          "type": "paragraph",
        },
        {
          "id": "p-175",
          "pageNumber": 9,
          "text": [
            {
              "text": "5.3.1.1.18.  Mirrors. ",
            },
          ],
          "type": "paragraph",
        },
      ],
