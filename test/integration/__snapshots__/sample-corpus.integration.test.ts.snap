            {
              "cells": [
                {
                  "blocks": [
                    {
                      "id": "p-538",
                      "pageNumber": 29,
                      "text": [
                        {
                          "text": "2.7. Curves- Before entering the  curve; reduces speed and keeps  vehicle in the lane; continue checking  traffic in all directions. ",
                        },
                      ],
                      "type": "paragraph",
                    },
                  ],
                  "colSpan": 1,
                  "id": "th-29",
                  "isHeader": true,
                  "pageNumber": 29,
                  "rowSpan": 1,
