# Local PostgreSQL development settings. Copy this file to .env to override
# the defaults used by compose.yaml. Never commit a real production password.
PDF_DB_NAME=pdf_to_html
PDF_DB_USER=pdf_to_html
PDF_DB_PASSWORD=pdf_to_html_dev
PDF_DB_PORT=54329
PDF_API_PORT=3001
PDF_WEB_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_DOCUMENT_API_BASE=http://localhost:3001

# The future Node integration can consume this connection string.
DATABASE_URL=postgresql://pdf_to_html:pdf_to_html_dev@localhost:54329/pdf_to_html
