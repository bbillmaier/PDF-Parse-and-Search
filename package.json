{
  "name": "pdf-to-html",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/integration/epic-g-lifecycle-search.integration.test.ts test/integration/api-postgres.integration.test.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "bench": "vite-node test/bench/run.ts",
    "bench:search": "vite-node test/bench/search-bench.ts",
    "server": "vite-node server/run.ts",
    "db:migrate": "vite-node server/migrate.ts",
    "db:smoke": "vite-node server/db-smoke.ts",
    "db:reindex-search": "vite-node server/reindex-search.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps postgres",
    "db:logs": "docker compose logs postgres",
    "db:shell": "docker compose exec postgres psql -U pdf_to_html -d pdf_to_html",
    "demo:up": "docker compose up -d --build --wait",
    "demo:down": "docker compose down",
    "demo:status": "docker compose ps",
    "demo:logs": "docker compose logs -f web api postgres",
    "demo:export": "powershell -ExecutionPolicy Bypass -File scripts/export-demo-images.ps1"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.10"
  }
}
